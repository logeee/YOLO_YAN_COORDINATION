# ROS2 environment and robot-specific DDS / SDK settings.
G1D_BODY_ROS_SETUP=/opt/ros/foxy/setup.bash
G1D_BODY_SLAM_SETUP=/unitree/module/slamware_service_pc4/install/setup.bash
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
G1D_BODY_INTERFACE=eth0
G1D_BODY_SIMPLE_CONTROL_BIN=/home/unitree/unitree_sdk2/build/bin/g1d_simple_control
G1D_BODY_HEIGHT_CONTROL_BIN=/home/unitree/unitree_sdk2/build/bin/g1d_height_control
G1D_BODY_LIFT_HEIGHT_URL=http://127.0.0.1:28089/api/basic_status
G1D_BODY_COMMAND_TOPIC=/g1d_body_control/task_command
G1D_BODY_STATUS_TOPIC=/g1d_body_control/task_status
# Optional: explicit DDS configuration, otherwise uses ~/cyclonedds.xml if present.
# CYCLONEDDS_URI=file:///home/unitree/cyclonedds.xml
