# Copy to g1d_tool_portal.env and set this robot's box addresses.
G1D_BOX_PUBLIC_HOST=192.168.61.132
G1D_BOX_INTERNAL_HOST=192.168.123.5
G1D_PORTAL_HOST=0.0.0.0
G1D_PORTAL_PORT=18079
G1D_PORTAL_PROBE_TIMEOUT=1.2

# Installed arm stack release shown in the portal. Leave empty when unknown.
G1D_ARM_IK_VERSION=

# Robot-specific service layout.
G1D_SUCTION_TYPE=es80z
G1D_ES80Z_LOCATION=box
G1D_CONTROL_API_ENABLED=true
