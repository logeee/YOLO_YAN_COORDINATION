.page {
  min-height: 100vh;
  padding: 22rpx 22rpx 28rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.status-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.status-panel > view,
.speed-panel,
.log {
  border: 1rpx solid #26373d;
  border-radius: 12rpx;
  background: #111a1d;
  padding: 20rpx;
  box-sizing: border-box;
}

.status-card {
  min-width: 0;
}

.label {
  display: block;
  color: #8dc9d7;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.value {
  display: block;
  min-height: 42rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
  word-break: break-all;
}

.value.ok {
  color: #80e6b0;
}

.signal-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 48rpx;
  margin-top: 14rpx;
  color: #89aab2;
  font-size: 24rpx;
}

.signal-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #6b7280;
}

.signal-line.online {
  color: #8de6b5;
}

.signal-line.online .signal-dot {
  background: #3fe28d;
  box-shadow: 0 0 0 8rpx rgba(63, 226, 141, 0.08);
}

.signal-line.offline .signal-dot {
  background: #a04a4a;
}

.toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 148rpx;
  gap: 14rpx;
  margin-top: 18rpx;
}

.tool {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  padding: 0;
  border: 1rpx solid #37535c;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #2a3e45 0%, #1f3036 100%);
  color: #f4fbff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.tool:active {
  background: linear-gradient(180deg, #243940 0%, #1a2a30 100%);
  box-shadow: inset 0 0 0 4rpx rgba(105, 213, 229, 0.08);
}

.tool.danger {
  border-color: #ba3636;
  background: linear-gradient(180deg, #b42121 0%, #8d1717 100%);
  font-size: 28rpx;
  box-shadow: 0 8rpx 18rpx rgba(110, 20, 20, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.tool.danger:active {
  background: linear-gradient(180deg, #c42b2b 0%, #981818 100%);
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.08);
}

.device-list {
  margin-top: 18rpx;
  border: 1rpx solid #26373d;
  border-radius: 12rpx;
  background: #111a1d;
  padding: 16rpx;
  box-sizing: border-box;
}

.device-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8dc9d7;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.device-hint {
  color: #5f7d84;
  font-size: 22rpx;
}

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: #1d2b30;
  color: #f4fbff;
  box-sizing: border-box;
}

.device-item + .device-item {
  margin-top: 10rpx;
}

.device-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.device-rssi {
  display: block;
  margin-top: 4rpx;
  color: #88aeb7;
  font-size: 22rpx;
}

.device-action {
  color: #8de6b5;
  font-size: 26rpx;
  font-weight: 700;
}

.speed-panel {
  margin-top: 18rpx;
}

.speed-row {
  display: flex;
  justify-content: space-between;
  color: #bdeaf3;
  font-size: 26rpx;
}

.control-area {
  width: 100%;
  max-width: 640rpx;
  margin: 22rpx auto 0;
  box-sizing: border-box;
}

.control-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.control-row.single {
  justify-content: center;
}

.control-row.middle {
  justify-content: space-between;
}

.pad {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  width: 210rpx;
  min-width: 0;
  height: 112rpx;
  padding: 0;
  border-radius: 18rpx;
  border: 1rpx solid #496873;
  background: linear-gradient(180deg, #263b42 0%, #203138 100%);
  color: #f7fdff;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.pad-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: rgba(105, 213, 229, 0.08);
  font-size: 34rpx;
  line-height: 34rpx;
  color: #c9eaf1;
}

.column-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(105, 213, 229, 0.08);
}

.column-icon-down {
  justify-content: center;
}

.column-arrow-stem {
  width: 7rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #c9eaf1;
}

.column-arrow-head {
  width: 17rpx;
  height: 17rpx;
  border-left: 7rpx solid #c9eaf1;
  border-top: 7rpx solid #c9eaf1;
  border-radius: 3rpx 0 0 0;
  box-sizing: border-box;
}

.column-icon-up .column-arrow-head {
  transform: rotate(45deg);
  margin-bottom: -5rpx;
}

.column-icon-down .column-arrow-head {
  transform: rotate(225deg);
  margin-top: -5rpx;
}

.pad.is-active,
.column.is-active {
  border-color: #74d9e8;
  background: linear-gradient(180deg, #2c5964 0%, #254650 100%);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.22), 0 0 0 4rpx rgba(105, 213, 229, 0.14) inset;
}

.center-dot {
  flex: 0 0 auto;
  width: 22rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: #2b454c;
  box-shadow: 0 0 0 8rpx rgba(105, 213, 229, 0.04);
}

.column-area {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  max-width: 640rpx;
  margin: 20rpx auto 0;
}

.column {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
  height: 108rpx;
  padding: 0;
  border: 1rpx solid #496873;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #213b43 0%, #1b333a 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.log {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-height: 118rpx;
  max-height: 160rpx;
  margin-top: 18rpx;
  color: #bdeaf3;
  font-size: 22rpx;
  line-height: 32rpx;
}

.log.empty {
  justify-content: center;
  color: #5f7d84;
}
